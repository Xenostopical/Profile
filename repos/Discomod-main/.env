# Discord (required)
DISCORD_TOKEN=your-bot-token
CLIENT_ID=123456789012345678
SUPERUSER_ID=123456789012345678
CLIENT_SECRET=

# AI providers (optional, blank = skipped)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
WOLFRAM_APPID=
ERROR_WEBHOOK_URL=

# Dashboard / security
AI_KEY_ENCRYPTION_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_REDIRECT_URI=http://localhost:3000/auth/callback
DASHBOARD_PUBLIC_URL=
DASHBOARD_TRUST_PROXY=false
DASHBOARD_FORCE_INSECURE_COOKIES=false
DASHBOARD_BOT_PERMISSIONS=8

# Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Math / Python
MATH_RAM_LIMIT_MB=512
MATH_TIMEOUT_S=110
PYTHON_BIN=
QALCULATE_PATH=

# Model and base-URL overrides (blank = defaults)
OPENAI_MODEL=
CLAUDE_MODEL=
GROQ_MODEL=
GEMINI_MODEL=
MISTRAL_MODEL=
DEEPSEEK_MODEL=
XAI_MODEL=
OPENAI_BASE_URL=
GROQ_BASE_URL=
DEEPSEEK_BASE_URL=
MISTRAL_BASE_URL=
XAI_BASE_URL=

# Setup answers (a record only, setup doesn't read these back)
RUN_ENV_UPGRADE=false
RUN_ENV_NUKE=false
